# Скопируйте в .env. Секреты не отправляйте в чат и не добавляйте в Git.
BOT_TOKEN=
ADMIN_IDS=982023162
BRAND_NAME=Твой астролог
SUPPORT_CONTACT=
SELLER_NAME=
SELLER_INN=
TERMS_URL=
PRIVACY_URL=
# DB_PATH обязательно укажите при установке релиза рядом со старой версией.
# Например: /root/tarot_bot/users.db
DB_PATH=

# Реальная оплата включается после теста и заполнения реквизитов.
# Для цифровых услуг внутри Telegram правила требуют Stars; см. START_HERE.md.
PAYMENTS_ENABLED=false
# Закрытая проверка владельца: платят только ADMIN_IDS. Не меняет режим магазина.
# При false обязательны опубликованные TERMS_URL и PRIVACY_URL.
PAYMENTS_ADMIN_ONLY=false
# Показывать условия и сведения о данных внутри бота вместо обязательных внешних ссылок.
PAYMENT_DOCUMENTS_IN_BOT=false
# Одноразовое обнуление балансов, кроме ADMIN_IDS. Не заполнять без поручения владельца.
RESET_NON_ADMIN_TOKENS_ONCE=
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST=true
# auto: все разрешённые магазину способы; sbp: только СБП.
YOOKASSA_METHOD=auto
# Можно оставить пустым: бот подставит собственную ссылку t.me.
PAYMENT_RETURN_URL=

# Необязательный ИИ-слой для полных дневных раскладов.
# Без настройки работает исходный персональный алгоритм.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
